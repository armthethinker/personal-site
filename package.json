{
  "name": "andrewrmchughrocks",
  "version": "2026.1.0",
  "distPrefix": "andrewrmchughrocks-2026.1.0",
  "homepage": "http://andrewrmchugh.rocks",
  "repository": {
    "type": "git",
    "url": "https://github.com/armthethinker/personal-site.git"
  },
  "url": "http://andrewrmchugh.rocks",
  "description": "andrewrmchughrocks is a personal repository to seed app development.",
  "author": "Andrew R McHugh",
  "scripts": {
    "clean": "rm -rf assets/css/* assets/js/* _data/manifest.json",
    "sass:build": "sass _sass/main.scss assets/css/main.css --load-path=node_modules",
    "postcss": "postcss assets/css/main.css -u autoprefixer -o assets/css/main.css",
    "hash": "node scripts/hash-assets.js",
    "sync-frontmatter": "node scripts/sync-project-frontmatter.js",
    "scripts:build": "tsc",
    "js:vendor": "terser node_modules/bootstrap/dist/js/bootstrap.bundle.min.js node_modules/masonry-layout/dist/masonry.pkgd.min.js -o assets/js/vendor.min.js",
    "js:app": "terser _js/main.js -o assets/js/app.js --mangle --compress",
    "js:app:dev": "cp _js/main.js assets/js/app.js",
    "jekyll:serve": "bundle exec jekyll serve --livereload",
    "watch:sass": "sass _sass/main.scss assets/css/main.css --load-path=node_modules --watch",
    "watch:js": "chokidar \"_js/main.js\" -c \"npm run js:app:dev\"",
    "start": "npm run clean && npm run js:vendor && npm run js:app:dev && npm run sass:build && npm-run-all --parallel watch:sass watch:js jekyll:serve",
    "build": "npm run clean && npm run scripts:build && npm run sass:build && npm run postcss && npm run js:vendor && npm run js:app && npm run sync-frontmatter && npm run hash && bundle exec jekyll build",
    "imgoptim": "npm run scripts:build && node scripts/optimize-images.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^25.6.0",
    "@types/sharp": "^0.31.1",
    "autoprefixer": "^10.4.0",
    "chokidar-cli": "^3.0.0",
    "glob": "^13.0.6",
    "imageoptim-cli": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.0",
    "postcss-cli": "^10.0.0",
    "sass": "^1.60.0",
    "sharp": "^0.34.5",
    "terser": "^5.16.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.13.1",
    "masonry-layout": "^4.2.2"
  }
}
